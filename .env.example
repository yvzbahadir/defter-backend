# Neon (veya başka bir Postgres sağlayıcısı) bağlantı adresi
DATABASE_URL=postgresql://kullanici:sifre@host/veritabani?sslmode=require

# BotFather'dan aldığınız token
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenHere

# Sadece sizin mesajlarınızın işlenmesi için Telegram chat ID'niz
# (aşağıdaki README'de nasıl öğrenileceği anlatılıyor)
TELEGRAM_ALLOWED_CHAT_ID=

# Render'da deploy ettikten sonra size verilen public URL, örn:
# https://defter-backend.onrender.com
PUBLIC_URL=

PORT=3000

# (Opsiyonel ama önerilir) Bazı banka ekstresi PDF'leri (örn. Akbank/Axess) özel font
# kodlaması kullanıyor ve standart metin okuma bunlarda başarısız oluyor. Bu anahtar
# tanımlıysa, bot bu tür PDF'lerde otomatik olarak sayfaları görsele çevirip Claude'un
# görme yeteneğiyle okuyor. Ayrıca serbest metin ayrıştırma, fiş/fatura fotoğrafı okuma,
# doğal dil ile veri sorgulama, akıllı kategori tahmini ve aylık AI analizi de bu anahtarı
# kullanır. https://console.anthropic.com adresinden alabilirsiniz.
ANTHROPIC_API_KEY=

# (Opsiyonel) Proaktif bildirimler (tekrarlayan işlem oluşturma, yaklaşan taksit hatırlatması,
# bütçe aşımı uyarısı) için /cron/daily-check endpoint'ini dışarıdan günde bir kez tetiklemeniz
# gerekiyor (örn. cron-job.org ile, ücretsiz). Bu, o isteği doğrulamak için rastgele,
# tahmin edilemeyen bir şifre olmalı. README'de kurulum adımları var.
CRON_SECRET=
