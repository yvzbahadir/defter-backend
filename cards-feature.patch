+/** Bir tarihi, kartın hesap kesim gününe göre hangi ekstre dönemine düştüğünü hesaplar.
+ *  Kesim günü tanımlı değilse takvim ayını (YYYY-MM) döner. Bu, kartla yapılan giderlerin
+ *  "Giderler" tarafıyla ekstre dönemine göre entegre çalışmasını sağlayan temel fonksiyondur. */
+function statementKeyForCard(card, dateStr){
+  const d = new Date(dateStr);
+  if(!card.statementDay) return dateStr.slice(0,7);
+  let m = d.getMonth(), y = d.getFullYear();
+  if(d.getDate() > card.statementDay){ m += 1; if(m>11){ m=0; y+=1; } }
+  return y + '-' + String(m+1).padStart(2,'0');
+}
+function statementKeyLabel(key){
+  const [y,m] = key.split('-').map(Number);
+  return new Date(y, m-1, 1).toLocaleDateString('tr-TR', {month:'long', year:'numeric'});
+}
